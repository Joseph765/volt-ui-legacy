{
	"name": "volt-ui-svelte",
	"version": "0.1.1",
	"description": "Ship with confidence using Volt UI — modular, consistent, and ready for production.",
	"author": "Joseph Chauvin (https://github.com/Joseph765)",
	"license": "MIT",
	"homepage": "https://volt-ui.com",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Joseph765/Volt-UI"
	},
	"bugs": {
		"url": "https://github.com/Joseph765/Volt-UI/issues"
	},
	"keywords": [
		"design-system",
		"svelte",
		"svelte5",
		"ui-library",
		"svelte-components",
		"component-library"
	],
	"scripts": {
		"dev": "vite dev --host",
		"build": "vite build && npm run prepack",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"prepack": "svelte-kit sync && svelte-package && publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint ."
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"engines": {
		"node": "26.x"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@eslint/compat": "^1.4.0",
		"@eslint/js": "^9.39.1",
		"@sveltejs/adapter-vercel": "^7.0.5",
		"@sveltejs/kit": "^3.4.0",
		"@sveltejs/package": "^3.0.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^26",
		"eslint": "^9.39.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.13.1",
		"globals": "^16.5.0",
		"highlight.js": "^11.11.1",
		"prettier": "^3.7.4",
		"prettier-plugin-svelte": "^3.4.0",
		"publint": "^0.3.15",
		"svelte": "^5.58.0",
		"svelte-check": "^4.3.4",
		"typescript": "^6.0.0",
		"vite": "^8.3.8"
	}
}
